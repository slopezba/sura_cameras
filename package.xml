<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sura_cameras</name>
  <version>0.0.0</version>
  <description>Launch files for SURA camera image processing pipelines.</description>
  <maintainer email="iedo@uji.es">usuario</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>aruco_opencv</exec_depend>
  <exec_depend>cirtesu_tank_aruco_localization</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>image_proc</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
